# Optional inference-time tool router.
# Copy the settings you need into the repository-root .env.local file.

# policy: original behavior; Qwen/policy model selects the tool and arguments.
# jev: Jev selects the next tool; guided mode resolves explicit arguments in
# code and uses Qwen only when the arguments remain ambiguous.
TOOL_ROUTER=policy

# Required only when TOOL_ROUTER=jev. Keep the real value in ignored .env.local.
TYPESAFE_API_KEY=

JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai

# Decisions below this confidence automatically fall back to policy routing.
JEV_MIN_CONFIDENCE=0.80
# guided: deterministic explicit args -> schema/legality validation -> Qwen fallback
# legacy: old single-tool ReAct prompt; Qwen generates all arguments
ROUTER_ARGUMENT_MODE=guided

# Network resilience. Total attempts are 1 + JEV_MAX_RETRIES.
JEV_TIMEOUT_S=30
JEV_MAX_RETRIES=2
JEV_BACKOFF_S=0.75
